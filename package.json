{
  "name": "dsh-ssh-hosts",
  "version": "0.5.0",
  "description": "DeepSeek Harness 插件：保存多台 SSH 服务器并在 agent 会话中按主机名引用（命令执行 + 远端文件读写），可在设置界面里管理。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ssh",
    "remote",
    "servers"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "icon": "icon.svg",
  "files": [
    "lib",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "ssh-hosts.example.yaml",
    "docs",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:remote": "DSH_SSH_HOSTS_REMOTE=1 node --test test/remote.test.mjs",
    "smoke": "node scripts/smoke-remote.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfredhuang211/dsh-ssh-hosts.git"
  },
  "homepage": "https://github.com/alfredhuang211/dsh-ssh-hosts#readme",
  "bugs": {
    "url": "https://github.com/alfredhuang211/dsh-ssh-hosts/issues"
  },
  "author": "alfredhuang"
}
